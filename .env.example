# Local development only: copy to .env. Never commit .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DJANGO_SECURE_SSL_REDIRECT=0

# Render + Neon:
# DATABASE_URL=postgresql://<neon-user>:<password>@<neon-host>/<database>?sslmode=require
# Render automatically sets RENDER_EXTERNAL_HOSTNAME for the onrender.com domain.
# Production domain for this storefront (the www and onrender aliases redirect here):
# DJANGO_CANONICAL_HOST=attarbashiesf.ir
# DJANGO_ALLOWED_HOSTS=attarbashiesf.ir,www.attarbashiesf.ir
# DJANGO_CSRF_TRUSTED_ORIGINS=https://attarbashiesf.ir,https://www.attarbashiesf.ir
# DJANGO_DEBUG=0
# DJANGO_SECURE_SSL_REDIRECT=1
# Optional one-time administrator bootstrap (set these only in Render Environment):
# DJANGO_SUPERUSER_USERNAME=your-admin-username
# DJANGO_SUPERUSER_EMAIL=you@example.com
# DJANGO_SUPERUSER_PASSWORD=use-a-long-unique-password
# ZARINPAL_MERCHANT_ID=your-real-merchant-id
# ZARINPAL_SANDBOX=False
