# Local development only: copy to .env. Never commit .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DJANGO_SECURE_SSL_REDIRECT=0

# Railway: do NOT put passwords in Git. Add these values in Railway Variables.
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=${{RAILWAY_PUBLIC_DOMAIN}}
# DJANGO_CSRF_TRUSTED_ORIGINS=https://${{RAILWAY_PUBLIC_DOMAIN}}
# DJANGO_SECURE_SSL_REDIRECT=1
# ZARINPAL_MERCHANT_ID=your-real-merchant-id
# ZARINPAL_SANDBOX=False
