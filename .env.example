# Local development only: copy to .env. Never commit .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DJANGO_SECURE_SSL_REDIRECT=0

# Render + Neon:
# DATABASE_URL=postgresql://<neon-user>:<password>@<neon-host>/<database>?sslmode=require
# Render automatically sets RENDER_EXTERNAL_HOSTNAME for the onrender.com domain.
# You do not need to set DJANGO_ALLOWED_HOSTS or DJANGO_CSRF_TRUSTED_ORIGINS
# while using only the Render-provided domain.
# DJANGO_DEBUG=0
# DJANGO_SECURE_SSL_REDIRECT=1
# ZARINPAL_MERCHANT_ID=your-real-merchant-id
# ZARINPAL_SANDBOX=False
